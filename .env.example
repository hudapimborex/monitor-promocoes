# Copie este arquivo para ".env" na raiz do projeto e preencha os valores.

ENV=local

# Local (dev): não defina DATABASE_URL — o padrão já é um SQLite absoluto em
# backend/promo_monitor.db, então funciona igual não importa de onde você
# rodar o comando (zero setup).
# Produção (Render + Supabase): defina com a connection string do Supabase
# (Project Settings > Database > Connection string > URI), trocando
# "postgresql://" por "postgresql+psycopg2://".
# DATABASE_URL=postgresql+psycopg2://postgres:SENHA@db.xxxxxxxx.supabase.co:5432/postgres

# Firecrawl (https://www.firecrawl.dev) — plano free: 1000 créditos/mês.
FIRECRAWL_API_KEY=
FIRECRAWL_MONTHLY_CREDIT_BUDGET=900
FIRECRAWL_SCRAPE_TOP_N=2

# Telegram — crie um bot com o @BotFather e pegue o chat_id conversando com
# @userinfobot (ou veja o README para o passo a passo).
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=

# Auth (JWT) — troque por uma string aleatória longa antes de ir para produção.
JWT_SECRET=troque-isso-por-uma-string-aleatoria-longa
JWT_EXPIRE_MINUTES=10080

# Regras de detecção de queda real de preço.
PRICE_DROP_THRESHOLD_PCT=15
PRICE_BASELINE_WINDOW_DAYS=60
PRICE_MIN_STABLE_DAYS=3

# Usuário semeado no MVP — troque pelo seu e-mail real aqui no .env (este
# arquivo não é versionado/commitado, então fica só na sua máquina).
BOOTSTRAP_USER_EMAIL=seuemail@exemplo.com
BOOTSTRAP_USER_PASSWORD=troque-essa-senha
